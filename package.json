{
  "name": "@ljwei-stak/model-router-galgame",
  "version": "0.10.2",
  "type": "module",
  "description": "Official DeepSeek Harness desktop plugin: complexity-based model routing with official CLI tool probe/install, Agent Teams work packages, and a standalone Gal module (story & free modes)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alice-Marx/model-router-galgame.git"
  },
  "homepage": "https://github.com/Alice-Marx/model-router-galgame#readme",
  "bugs": {
    "url": "https://github.com/Alice-Marx/model-router-galgame/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./.dsh-plugin/index.mjs",
  "exports": {
    ".": "./.dsh-plugin/index.mjs",
    "./client": "./.dsh-plugin/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    ".dsh-plugin/index.mjs",
    ".dsh-plugin/official-tools-remote-service.mjs",
    ".dsh-plugin/client.js",
    ".dsh-plugin/shared/harness-plan.mjs",
    ".dsh-plugin/shared/model-profiles.mjs",
    ".dsh-plugin/shared/router.mjs",
    ".dsh-plugin/shared/livebench.mjs",
    ".dsh-plugin/shared/official-tool-registry.mjs",
    ".dsh-plugin/shared/official-tools-runtime.mjs",
    ".dsh-plugin/shared/official-tools-remote.mjs",
    ".dsh-plugin/shared/official-tool-executor.mjs",
    ".dsh-plugin/shared/vendor-minimax-adapter.mjs",
    ".dsh-plugin/shared/vendor-mimo-grok-adapter.mjs",
    ".dsh-plugin/shared/zcode-bundle.mjs",
    ".dsh-plugin/shared/zcode-installer.mjs",
    ".dsh-plugin/shared/official-team-runtime.mjs",
    ".dsh-plugin/shared/gal-story-echo.mjs",
    ".dsh-plugin/shared/gal-story-echocity.mjs",
    ".dsh-plugin/shared/gal-story-spring.mjs",
    ".dsh-plugin/shared/gal-spring-act1.mjs",
    ".dsh-plugin/shared/gal-spring-act2.mjs",
    ".dsh-plugin/shared/gal-spring-act3.mjs",
    ".dsh-plugin/shared/gal-spring-sides.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs/ECHO_CITY_STORY.zh.md",
    "docs/GAL_ART_SOURCES.zh.md",
    "docs/GAL_ART_PROMPTS.zh.md",
    "docs/assets/gal-portrait-sources.json",
    "docs/assets/gal-claude-0.10.1-preview.png",
    "docs/assets/gal-spring-0.10.1-preview.png",
    "INSTALLATION_GUIDE.zh.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "test": "node --test tests/router.test.mjs tests/harness-*.test.mjs tests/official-tools.test.mjs tests/official-team-runtime.test.mjs tests/model-profiles.test.mjs tests/model-profile-editor.test.mjs tests/tool-install-state.test.mjs tests/vendor-adapters.test.mjs tests/desktop-compat.test.mjs tests/gal-module.test.mjs tests/gal-art.test.mjs",
    "prepack": "node scripts/prepack.mjs",
    "pack:local": "npm pack --pack-destination dist"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.1 || 0.2.0-rc.2",
